+# babeldoc 用 <style id='N'>…</style> 保护带样式的文本段(如彩色引用链接)。
+# 小模型常把标签打碎后输出(如 <style id="5>、<style id="9>"),回贴正则只认
+# 规范形,残缺标签会原样漏进译文。这里把各种碎形归一化回规范形:
+#  - 右标签还在 → 样式正常回贴;
+#  - 右标签被模型丢掉 → 归一化后的标签会被 il_translator 的兜底清理剥掉,
+#    退化为无样式纯文本,而不是残留乱码。
+_STYLE_TAG_RE = re.compile(
+    r"<\s*style\s+id\s*=\s*[\"']?\s*(\d+)\s*[\s\"'>}]*>?\s*[\"']?"
+)
+
+
+def _normalize_style_tags(text: str) -> str:
+    if "<" not in text:
+        return text
+    return _STYLE_TAG_RE.sub(r"<style id='\1'>", text)
+
 
